# =============================================================================
# Server runtime
# =============================================================================

PORT=3001
NODE_ENV=development

# How many proxies in front (express trust proxy). 1 for Vite dev or a single LB.
TRUST_PROXY=1

# Path to the SQLite file. Defaults to server/data/app.db. Override if
# persisting to a mounted volume.
# DB_PATH=./server/data/app.db


# =============================================================================
# First-boot admin seed (only used when the users table has zero admins)
# =============================================================================

DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=


# =============================================================================
# Backblaze B2 credentials
# =============================================================================

# Master partner key. Required for live-mode Partner API calls and for the
# archive-reports / object-count background jobs.
B2_MASTER_KEY_ID=
B2_MASTER_APP_KEY=

# AES-256-GCM key for encrypting sub-account application keys stored in the
# account_credentials table. Min 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# WARNING: losing or rotating this value makes every stored sub-account key
# permanently unrecoverable. Back this value up SEPARATELY from the database
# (vault, secret manager, sealed envelope).
CREDENTIAL_ENCRYPTION_KEY=


# =============================================================================
# Conversational MCP console (the "talk to your storage" agent)
# =============================================================================

# Anthropic API key. Powers the MCP console's chat mode, where Claude turns
# intent into scoped Backblaze MCP tool calls (control plane only — never
# object data). This is a server infra secret, one per deployment (NOT a
# per-tenant credential). Without it, the chat mode is disabled and the
# console falls back to the manual tool-picker. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Optional — override the model used by the chat agent. Default is
# claude-sonnet-4-6 (cost-effective and strong at tool orchestration). Use
# claude-haiku-4-5 for minimum cost, or claude-opus-4-8 for maximum capability.
# MCP_CHAT_MODEL=claude-sonnet-4-6


# =============================================================================
# Single sign-on (OIDC) — optional
# =============================================================================

# Absolute public base URL of this deployment, e.g. https://portal.example.com
# Used to build the OIDC redirect URI that you register with your identity
# provider. If unset it is derived from the X-Forwarded-Proto / Host headers,
# which works behind the nginx config in deploy/ but is worth pinning in
# production so a spoofed Host header cannot influence the redirect.
# APP_BASE_URL=

# Optional comma-separated exact host allow-list for OIDC issuers. When set,
# ONLY these hosts may be configured as an issuer, which closes off the
# server-side request forgery surface that an operator-supplied issuer URL
# otherwise opens. Recommended in production.
# SSO_ALLOWED_ISSUER_HOSTS=login.microsoftonline.com,sso.example.com

# Everything else about SSO — issuer, client id, client secret, group mappings —
# is configured in the portal UI under Settings, and stored (encrypted) in the
# database. There is nothing else to set here.


# =============================================================================
# Audit log retention
# =============================================================================

# Entries older than this many days are pruned by a daily background job.
# 365 lines up with typical SOC2 / NIST 800-53 windows. Set to 0 to disable
# pruning entirely (keeps everything forever — table grows unbounded).
# AUDIT_RETENTION_DAYS=365


# =============================================================================
# Optional — admin protection
# =============================================================================

# Comma-separated emails that admins cannot modify / reset / deactivate.
# Use to protect the seed admin from being locked out by a peer admin.
# Empty = no accounts protected.
# PROTECTED_ACCOUNT_EMAIL=admin@example.com,demo@example.com


# =============================================================================
# Optional — health monitor (server/health-monitor.mjs)
# =============================================================================

# HEALTH_URL=http://localhost:3001/api/auth/me
# HEALTH_INTERVAL_MS=60000
# HEALTH_TIMEOUT_MS=10000
# HEALTH_FAIL_COUNT=3
# HEALTH_COOLDOWN_MS=60000
# HEALTH_PM2_TARGET=neocloud-api
